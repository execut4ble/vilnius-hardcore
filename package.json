    "rehype-raw": "^7.0.0",
    "remark-youtube": "^1.3.3",
    "remove-markdown": "^0.7.0",
    "rss": "^1.2.2",
    "svelte-exmarkdown": "^5.0.2",
    "svelte-fa": "^4.0.4",
    "svelte-relative-time": "^0.0.6",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
