{
  "name": "vilnius-hardcore",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test": "npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/fira-mono": "^5.3.0",
    "@neoconfetti/svelte": "^2.2.2",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/rss": "^0.0.32",
    "@types/validator": "^13.15.10",
    "date-picker-svelte": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@friendofsvelte/toggle": "^0.0.4-svelte.5",
    "@inlang/paraglide-js": "^3.2.2",
    "@lucide/svelte": "^1.72.0",
    "@node-rs/argon2": "^2.2.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "file-type": "^22.3.0",
    "ical-generator": "^11.1.3",
    "ioredis": "^6.0.0",
    "postgres": "^4.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-youtube": "^1.3.3",
    "remove-markdown": "^0.8.0",
    "rss": "^1.2.2",
    "svelte-exmarkdown": "^5.0.2",
    "svelte-fa": "^4.0.4",
    "svelte-relative-time": "^0.1.0",
    "validator": "^13.15.35",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
